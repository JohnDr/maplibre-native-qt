index 95805acc4934..ead1ba688332 100644
--- a/include/mln/renderer/layer_tweaker.hpp
+++ b/include/mln/renderer/layer_tweaker.hpp
@@ -89,6 +89,25 @@ protected:
                               std::uint32_t baseElement = 0,
                               std::uint32_t totalElements = 0);
     gfx::UniformBufferPtr projectionUniformBuffer;
+
+    /// Block layout of a layer's consolidated UBO arrays when it is drawn into terrain drape targets. All drape
+    /// targets are recorded into one command buffer and each has its own projection, so every target needs its own
+    /// block of `drawableCount` elements, selected per draw through `uboIndex`. Block 0 is the normal (non-drape)
+    /// pass, drape target `ordinal` uses block `ordinal + 1`. Without draping `base` is 0 and `total` is
+    /// `drawableCount`.
+    struct DrapeUBOWindow {
+        std::uint32_t base = 0;
+        std::uint32_t total = 0;
+    };
+    static DrapeUBOWindow drapeUBOWindow(const PaintParameters&, std::size_t drawableCount);
+
+    /// Write `count` elements of `elementSize` bytes at the window's block, sizing the buffer for all blocks.
+    static void updateWindowedBuffer(gfx::UniformBufferPtr&,
+                                     gfx::Context&,
+                                     const void* data,
+                                     std::size_t elementSize,
+                                     std::size_t count,
+                                     const DrapeUBOWindow&);
 #endif
 
     /// Multiplies with the projection matrix (either default, near clipped or aligned) for the given drawable
diff --git a/src/mln/renderer/layer_tweaker.cpp b/src/mln/renderer/layer_tweaker.cpp
index 364754a90e0f..0fbd00a903d7 100644
--- a/src/mln/renderer/layer_tweaker.cpp
+++ b/src/mln/renderer/layer_tweaker.cpp
@@ -113,6 +113,32 @@ void LayerTweaker::uploadProjectionUBOs(gfx::UniformBufferArray& layerUniforms,
 }
 #endif
 
+#if MLN_UBO_CONSOLIDATION
+LayerTweaker::DrapeUBOWindow LayerTweaker::drapeUBOWindow(const PaintParameters& parameters,
+                                                          std::size_t drawableCount) {
+    const auto dc = static_cast<std::uint32_t>(drawableCount);
+    DrapeUBOWindow window;
+    window.base = parameters.drapeTargetOrdinal >= 0 ? (static_cast<std::uint32_t>(parameters.drapeTargetOrdinal) + 1u) * dc
+                                                     : 0u;
+    window.total = parameters.drapeTargetCount > 0 ? (parameters.drapeTargetCount + 1u) * dc : dc;
+    return window;
+}
+
+void LayerTweaker::updateWindowedBuffer(gfx::UniformBufferPtr& buffer,
+                                        gfx::Context& context,
+                                        const void* data,
+                                        std::size_t elementSize,
+                                        std::size_t count,
+                                        const DrapeUBOWindow& window) {
+    const std::size_t totalBytes = elementSize * std::max<std::size_t>(window.total, window.base + count);
+    if (!buffer || buffer->getSize() < totalBytes) {
+        std::vector<std::uint8_t> initial(totalBytes, 0);
+        buffer = context.createUniformBuffer(initial.data(), totalBytes, false, true);
+    }
+    buffer->update(data, elementSize * count, elementSize * window.base);
+}
+#endif
+
 void LayerTweaker::updateProperties(Immutable<style::LayerProperties> newProps) {
     evaluatedProperties = std::move(newProps);
     propertiesUpdated = true;
