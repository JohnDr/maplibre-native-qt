+void TerrainTileManager::requestAncestor(const CanonicalTileID& id, uint8_t zoom) {
+    if (id.z < zoom) {
+        return;
+    }
+    const int shift = id.z - zoom;
+    getDEMData(CanonicalTileID(zoom, id.x >> shift, id.y >> shift));
+}
